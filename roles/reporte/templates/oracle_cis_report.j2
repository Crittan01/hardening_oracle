                                        No Conforme ({{ instance_data.cis_69.invalid_count }} de {{ instance_data.cis_69.total_paths }} rutas no cumplen)
                                    {% endif %}
                                {% endif %}
                            </td>
                            <td class="{{ 'pass' if instance_data.cis_69.compliant_final else 'fail' }}">
                                {% if instance_data.cis_69.path_details | length == 0 %}
                                    No aplicable (sin rutas configuradas)
                                {% else %}
                                    {% if instance_data.cis_69.compliant_final %}
                                        Conforme ({{ instance_data.cis_69.valid_count }} de {{ instance_data.cis_69.total_paths }} rutas)
                                    {% else %}
                                        No Conforme ({{ instance_data.cis_69.invalid_count }} de {{ instance_data.cis_69.total_paths }} rutas no cumplen)
                                    {% endif %}
                                {% endif %}
                            </td>
                            <td>
                                {% if instance_data.cis_69.path_details | length == 0 %}
                                    <span class="change-indicator neutral">No aplicable</span>
                                {% elif instance_data.cis_69.was_remediated %}
                                    <span class="change-indicator positive">✓ Remediado</span>
                                {% elif instance_data.cis_69.compliant_initial and instance_data.cis_69.compliant_final %}
                                    <span class="change-indicator neutral">Ya conforme</span>
                                {% elif not instance_data.cis_69.compliant_initial and not instance_data.cis_69.compliant_final %}
                                    <span class="change-indicator manual">Requiere revisión manual</span>
                                {% else %}
                                    <span class="change-indicator negative">Degradado</span>
                                {% endif %}
                            </td>
                        </tr>
                        {% endif %}

                        <!-- CIS 70 - Archivos de configuración de red Oracle -->
                        {% if instance_data.cis_70 is defined %}
                        {% set instance_user = reporte_instances_info[instance].user | default('oracle') %}

                        <tr>
                            <td>
                                <span class="control-id">CIS 70</span>
                                {{ instance_data.cis_70.parametro }}
                                <br><small>Usuario: {{ instance_user }}</small>
                            </td>
                            <td class="{{ 'pass' if instance_data.cis_70.compliant_initial else 'fail' }}">
                                {{ 'Conforme' if instance_data.cis_70.compliant_initial else 'No Conforme' }}
                            </td>
                            <td class="{{ 'pass' if instance_data.cis_70.compliant_final else 'fail' }}">
                                {{ 'Conforme' if instance_data.cis_70.compliant_final else 'No Conforme' }}
                            </td>
                            <td>
                                {% if not instance_data.cis_70.compliant_initial and not instance_data.cis_70.compliant_final %}
                                <span class="change-indicator manual">Requiere revisión manual</span>
                                {% elif instance_data.cis_70.compliant_initial and instance_data.cis_70.compliant_final %}
                                <span class="change-indicator neutral">Ya conforme</span>
                                {% endif %}
                            </td>
                        </tr>
                        {% endif %}
                    </table>
                    
                    <h3 style="margin-top: 25px;">Cambios Aplicados</h3>
                    <table>
                        <tr>
                            <th>Métrica</th>
                            <th>Antes</th>
                            <th>Después</th>
                            <th>Cambio</th>
                        </tr>
                        <tr>
                            <td>Controles Conformes</td>
                            <td>{{ initial_compliant }} de {{ total_checks }}</td>
                            <td>{{ final_compliant }} de {{ total_checks }}</td>
                            <td>
                                {% if initial_compliant != final_compliant | int %}
                                    {% if initial_compliant < final_compliant | int %}
                                        <span class="change-indicator positive">+{{ final_compliant | int - initial_compliant | int }}</span>
                                    {% else %}
                                        <span class="change-indicator negative">{{ final_compliant | int - initial_compliant | int }}</span>
                                    {% endif %}
                                {% else %}
                                    <span>-</span>
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <td>Porcentaje de Cumplimiento</td>
                            <td>{{ initial_percent }}%</td>
                            <td>{{ final_percent }}%</td>
                            <td>
                                {% if initial_percent | int != final_percent | int %}
                                    {% if initial_percent | int < final_percent | int %}
                                        <span class="change-indicator positive">+{{ final_percent | int - initial_percent | int }}%</span>
                                    {% else %}
                                        <span class="change-indicator negative">{{ final_percent | int - initial_percent | int }}%</span>
                                    {% endif %}
                                {% else %}
                                    <span>-</span>
                                {% endif %}
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    
    <script>
        // Función para cambiar entre las pestañas
        function openTab(tabName) {
            // Ocultar todos los contenidos de pestaña
            var contents = document.getElementsByClassName('tab-content');
            for (var i = 0; i < contents.length; i++) {
                contents[i].style.display = 'none';
            }
            
            // Desactivar todos los botones
            var buttons = document.getElementsByClassName('tab-button');
            for (var i = 0; i < buttons.length; i++) {
                buttons[i].classList.remove('active');
            }
            
            // Mostrar el contenido seleccionado
            document.getElementById(tabName).style.display = 'block';
            
            // Activar el botón correspondiente
            var activeButtons = document.querySelectorAll('.tab-button');
            for (var i = 0; i < activeButtons.length; i++) {
                if (activeButtons[i].getAttribute('onclick').includes(tabName)) {
                    activeButtons[i].classList.add('active');
                }
            }
        }
        
        // Función para cambiar entre instancias
        function changeInstance(instanceName) {
            // Ocultar todos los contenidos de instancia
            var contents = document.getElementsByClassName('instance-content');
            for (var i = 0; i < contents.length; i++) {
                contents[i].classList.remove('active');
            }
            
            // Si no se ha seleccionado nada, mostrar el placeholder
            if (!instanceName) {
                document.getElementById('content-placeholder').classList.add('active');
                return;
            }
            
            // Ocultar el placeholder y mostrar la instancia seleccionada
            document.getElementById('content-placeholder').classList.remove('active');
            document.getElementById('content-' + instanceName).classList.add('active');
        }
    </script>
</body>
</html>