<!DOCTYPE html>
<html>
<head>
    <title>Informe de Cumplimiento CIS Oracle 19c</title>
    <style>
        /* Estilos base modernizados */
        :root {
            --color-primary: #7a0010;     /* rojo burdeos */
            --color-secondary: #e60012;   /* rojo vibrante */
            --color-accent: #1abc9c;
            --color-success: #27ae60;
            --color-warning: #f39c12;
            --color-danger: #e74c3c;
            --color-light: #ecf0f1;
            --color-dark: #2c3e50;
            --color-card: #ffffff;
            --shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            --radius: 8px;
        }
        
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
            color: var(--color-dark);
            background-color: #f5f7fa;
            padding: 0;
            margin: 0;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }
        
        /* Encabezado con banner */
        .header {
            background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
            color: white;
            padding: 25px 20px;
            border-radius: var(--radius);
            margin-bottom: 25px;
            box-shadow: var(--shadow);
            position: relative;
            overflow: hidden;
        }
        
        .header::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 100 100"><rect fill="none" width="100" height="100"/><path fill="rgba(255,255,255,0.05)" d="M100,36.8c0,22.6-18.3,40.9-40.9,40.9S18.2,59.4,18.2,36.8S36.5-4.1,59.1-4.1S100,14.2,100,36.8z"/></svg>');
            background-size: 300px;
            opacity: 0.5;
        }
        
        .header-content {
            position: relative;
            z-index: 2;
        }
        
        .header h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 600;
            text-align: center;
        }
        
        .header-info {
            display: flex;
            justify-content: space-between;
            margin-top: 15px;
            font-size: 16px;
        }
        
        /* Dashboard Cards */
        .dashboard {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 20px;
            margin-bottom: 25px;
        }
        
        .summary-card {
            background-color: var(--color-card);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            padding: 20px;
            display: flex;
            flex-direction: column;
        }
        
        .summary-title {
            font-size: 16px;
            font-weight: 600;
            color: var(--color-primary);
            margin-bottom: 15px;
            display: flex;
            align-items: center;
        }
        
        .summary-title::before {
            content: "";
            display: inline-block;
            width: 4px;
            height: 18px;
            background-color: var(--color-secondary);
            margin-right: 10px;
            border-radius: 2px;
        }
        
        .chart-container {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
        }
        
        .chart-item {
            text-align: center;
            position: relative;
            flex: 1;
        }
        
        .chart-label {
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 10px;
            color: var(--color-dark);
        }
        
        .donut-chart {
            width: 100px;
            height: 100px;
            margin: 0 auto;
            position: relative;
        }
        
        .donut-segment {
            stroke-width: 10;
            fill: transparent;
            transform: rotate(-90deg);
            transform-origin: center;
            transition: stroke-dashoffset 0.8s ease-in-out;
        }
        
        .donut-hole {
            fill: white;
        }
        
        .donut-label {
            font-size: 18px;
            font-weight: 700;
            fill: var(--color-dark);
            text-anchor: middle;
            dominant-baseline: middle;
        }
        
        .impact-message {
            background-color: #f8f9fa;
            border-left: 4px solid var(--color-accent);
            padding: 15px;
            border-radius: 0 var(--radius) var(--radius) 0;
            margin-top: 15px;
        }
        
        .change-indicator {
            display: inline-block;
            padding: 4px 8px;
            border-radius: 3px;
            font-weight: 600;
            font-size: 12px;
        }
        
        .positive {
            background-color: rgba(39, 174, 96, 0.1);
            color: var(--color-success);
        }
        
        .negative {
            background-color: rgba(231, 76, 60, 0.1);
            color: var(--color-danger);
        }
        
        .neutral {
            background-color: rgba(243, 156, 18, 0.1);
            color: var(--color-warning);
        }
        
        /* Pestañas */
        .tabs-container {
            margin-bottom: 30px;
        }
        
        .tabs {
            display: flex;
            background-color: var(--color-card);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            overflow: hidden;
            position: relative;
        }
        
        .tab-button {
            flex: 1;
            border: none;
            background: none;
            padding: 15px;
            cursor: pointer;
            transition: all 0.3s;
            font-weight: 600;
            font-size: 14px;
            color: var(--color-dark);
            position: relative;
            overflow: hidden;
            text-align: center;
            z-index: 1;
        }
        
        .tab-button:hover {
            background-color: rgba(52, 152, 219, 0.1);
        }
        
        .tab-button.active {
            color: white;
        }
        
        .tab-button.active::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: var(--color-secondary);
            z-index: -1;
        }
        
        .tab-content {
            display: none;
            background-color: var(--color-card);
            border-radius: var(--radius);
            padding: 25px;
            margin-top: 20px;
            box-shadow: var(--shadow);
        }
        
        /* Control boxes */
        .control-box {
            border: 1px solid #e1e4e8;
            border-radius: var(--radius);
            margin-bottom: 25px;
            transition: all 0.3s;
        }
        
        .control-box:hover {
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        }
        
        .control-header {
            padding: 15px 20px;
            border-bottom: 1px solid #e1e4e8;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .control-title {
            font-size: 16px;
            font-weight: 600;
            margin: 0;
            display: flex;
            align-items: center;
        }
        
        .control-id {
            display: inline-block;
            background-color: var(--color-secondary);
            color: white;
            border-radius: 4px;
            padding: 2px 8px;
            font-size: 12px;
            margin-right: 10px;
        }
        
        .control-body {
            padding: 20px;
        }
        
        .control-description {
            margin-bottom: 20px;
            color: #666;
        }
        
        .requirement {
            font-weight: 600;
            display: block;
            margin-bottom: 10px;
        }
        
        /* Tablas */
        table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
            font-size: 14px;
        }
        
        th {
            background-color: #f8f9fa;
            font-weight: 600;
            text-align: left;
            padding: 12px;
            border-bottom: 2px solid #e1e4e8;
        }
        
        td {
            padding: 12px;
            border-bottom: 1px solid #e1e4e8;
        }
        
        .pass {
            background-color: rgba(39, 174, 96, 0.1);
        }
        
        .fail {
            background-color: rgba(231, 76, 60, 0.1);
        }
        
        .na {
            background-color: rgba(189, 195, 199, 0.3);
        }
        
        .info {
            background-color: rgba(52, 152, 219, 0.1);
        }
        
        .manual {
            background-color: rgba(142, 68, 173, 0.1);
        }
        
        /* Info box */
        .info-box {
            background-color: #f8f9fa;
            padding: 15px;
            border-left: 4px solid #f39c12;
            border-radius: 0 8px 8px 0;
            margin: 15px 0;
        }
        
        /* Remediation */
        .remediation {
            background-color: #f8f9fa;
            border-radius: var(--radius);
            padding: 15px;
            font-family: 'Consolas', 'Monaco', monospace;
            font-size: 13px;
            line-height: 1.6;
            overflow-x: auto;
            margin: 15px 0;
            border-left: 4px solid var(--color-secondary);
            white-space: pre;
        }
        
        /* Comparación */
        .comparison-table {
            border: 1px solid #e1e4e8;
            border-radius: var(--radius);
            overflow: hidden;
        }
        
        .comparison-table th {
            background-color: var(--color-primary);
            color: white;
        }
        
        /* Selector de instancias */
        .instance-selector {
            margin-bottom: 20px;
            padding: 15px;
            background-color: var(--color-card);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
        }
        
        .instance-selector select {
            padding: 10px;
            border-radius: 4px;
            border: 1px solid #ddd;
            width: 100%;
            font-size: 16px;
        }
        
        /* Instancia específica */
        .instance-content {
            display: none;
        }
        
        .instance-content.active {
            display: block;
        }
        
        /* Placeholder de selección */
        #content-placeholder {
            background-color: var(--color-card);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            padding: 20px;
            margin-bottom: 20px;
        }
        
        /* Responsive */
        @media (max-width: 768px) {
            .dashboard {
                grid-template-columns: 1fr;
            }
            
            .chart-container {
                flex-direction: column;
                align-items: center;
            }
            
            .chart-item {
                margin-bottom: 20px;
            }
        }

        .status-indicator {
            display: inline-flex;
            align-items: center;
            font-weight: 600;
        }
        
        .status-indicator::before {
            content: "";
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            margin-right: 5px;
        }
        
        .status-success::before {
            background-color: var(--color-success);
        }
        
        .status-warning::before {
            background-color: var(--color-warning);
        }
        
        .status-danger::before {
            background-color: var(--color-danger);
        }
        
        .status-info::before {
            background-color: #3498db;
        }
        
        .status-manual::before {
            background-color: #8e44ad;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Encabezado con banner -->
        <div class="header">
            <div class="header-content">
                <h1>{{ oracle_version_full_j2 }}</h1>
                <div class="header-info">
                    <div><strong>Servidor:</strong> {{ hostname }}</div>
                    <div><strong>Fecha:</strong> {{ date }}</div>
                </div>
            </div>
        </div>
        
        <!-- Selector de instancias -->
        <div class="instance-selector">
            <h2 class="summary-title">Instancias Oracle</h2>
            <p>Se detectaron <strong>{{ reporte_all_instances | length }}</strong> instancia(s): 
                {% for inst in reporte_all_instances %}
                    {{ inst }}{% if not loop.last %}, {% endif %}
                {% endfor %}
            </p><br>
            
            <select id="instanceSelector" onchange="changeInstance(this.value)">
                <option value="" disabled selected>Seleccione una instancia...</option>
                {% for instance in reporte_all_instances %}
                <option value="{{ instance }}">{{ instance }}</option>
                {% endfor %}
            </select>
        </div>
        
        <!-- Placeholder: Mensaje inicial hasta que se seleccione una instancia -->
        <div id="content-placeholder" class="instance-content active">
            <p>Por favor seleccione alguna instancia de la lista desplegable para ver la información.</p>
        </div>
        
        <!-- Contenidos específicos por instancia -->
        {% for instance in reporte_all_instances %}
        {% set instance_data = {} %}
        {% for control_data in reporte_instances_data | selectattr('instance_name', 'equalto', instance) %}
            {% set _ = instance_data.update(control_data) %}
        {% endfor %}

        <div id="content-{{ instance }}" class="instance-content">
        {% set instance_user = reporte_instances_info[instance].user | default('oracle') %}
        {% set instance_home = reporte_instances_info[instance].home | default('/u01/app/oracle/product/19.0.0/dbhome_1') %}
        {% set instance_base = reporte_instances_info[instance].base | default('/u01/app/oracle') %}

            <h2 class="summary-title">Instancia: {{ instance }}</h2>
            <p><strong>USUARIO</strong>: {{ instance_user }}</p>
            <p><strong>ORACLE_HOME</strong>: {{ instance_home }}</p>
            <p><strong>ORACLE_BASE</strong>: {{ instance_base }}</p>

            <!-- Dashboard específico para esta instancia -->
            <div class="dashboard">
                <div class="summary-card">
                    <h2 class="summary-title">Resumen de Cumplimiento</h2>
                    
                    {% set cis_controls = [] %}
                    {% for key, value in instance_data.items() %}
                        {% if key.startswith('cis_') %}
                            {% set _ = cis_controls.append(key) %}
                        {% endif %}
                    {% endfor %}
                    {% set total_checks = cis_controls|length %}
                    {% set initial_compliant = 0 %}
                    {% set final_compliant = 0 %}

                    {% if instance_data.cis_1 is defined %}
                        {% if instance_data.cis_1.compliant_initial | default(false) %}
                            {% set initial_compliant = initial_compliant + 1 %}
                        {% endif %}
                        {% if instance_data.cis_1.compliant_final | default(false) %}
                            {% set final_compliant = final_compliant + 1 %}
                        {% endif %}
                    {% endif %}

                    {% if instance_data.cis_2 is defined %}
