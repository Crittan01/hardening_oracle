                                <p><span class="change-indicator neutral">Sin cambios (todo conforme)</span></p>
                            {% else %}
                                <p>No se han podido remediar las vulnerabilidades. Se requiere revisión manual.</p>
                                <p><span class="change-indicator neutral">Sin cambios (siguen no conformes)</span></p>
                            {% endif %}
                        {% elif initial_percent < final_percent %}
                            <p>Se han remediado <strong>{{ final_compliant - initial_compliant }} vulnerabilidades de seguridad</strong> en esta instancia.</p>
                            <p><span class="change-indicator positive">+{{ final_percent - initial_percent }}% de cumplimiento</span></p>
                        {% else %}
                            <p>¡Advertencia! Ha habido una degradación en el cumplimiento.</p>
                            <p><span class="change-indicator negative">{{ final_percent - initial_percent }}% de cumplimiento</span></p>
                        {% endif %}
